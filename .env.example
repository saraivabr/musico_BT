# Saraiva - Compositor Musical WhatsApp
# Copie este arquivo para .env e preencha os valores

# Servidor
PORT=3008

# MongoDB
MONGODB_URI=mongodb://localhost:27017/saraiva-musico

# Google Gemini (para gerar letras)
GEMINI_API_KEY=your_gemini_api_key_here

# Suno API (para gerar músicas)
SUNO_API_KEY=your_suno_api_key_here
SUNO_API_URL=https://api.sunoapi.org

# Woovi/OpenPix (para pagamentos PIX)
WOOVI_APP_ID=your_woovi_app_id_here
WOOVI_WEBHOOK_SECRET=your_webhook_secret_optional

# Webhook (URL pública para receber callbacks do Woovi)
WEBHOOK_BASE_URL=https://your-domain.com

# Bot
BOT_NAME=Saraiva
